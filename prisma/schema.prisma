generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model Project {
  id                 String            @id @default(cuid())
  pekerjaan          String?
  spmk               String?
  akhirKontrak       String?           @map("akhir_kontrak")
  alatData           Json?             @map("alat_data")
  bangunanDeviasi    Float?            @default(0) @map("bangunan_deviasi")
  bangunanProgress   Float?            @default(0) @map("bangunan_progress")
  bangunanTarget     Float?            @default(0) @map("bangunan_target")
  createdAt          DateTime          @default(now()) @map("created_at")
  fisikDeviasi       Float?            @default(0) @map("fisik_deviasi")
  fisikProgress      Float?            @default(0) @map("fisik_progress")
  fisikTarget        Float?            @default(100) @map("fisik_target")
  jenisPaket         String?           @map("jenis_paket")
  jenisPengadaan     String?           @map("jenis_pengadaan")
  keuanganDeviasi    Float?            @default(0) @map("keuangan_deviasi")
  keuanganProgress   Float?            @default(0) @map("keuangan_progress")
  keuanganTarget     Float?            @default(0) @map("keuangan_target")
  masaKontrak        String?           @map("masa_kontrak")
  materialData       Json?             @map("material_data")
  nilaiKontrak       String?           @map("nilai_kontrak")
  nomorKontrak       String?           @map("nomor_kontrak")
  outputData         Json?             @map("output_data")
  paguAnggaran       String?           @map("pagu_anggaran")
  pembayaranTerakhir String?           @map("pembayaran_terakhir")
  penyediaJasa       String?           @map("penyedia_jasa")
  saluranDeviasi     Float?            @default(0) @map("saluran_deviasi")
  saluranProgress    Float?            @default(0) @map("saluran_progress")
  saluranTarget      Float?            @default(0) @map("saluran_target")
  tanggalKontrak     String?           @map("tanggal_kontrak")
  tenagaKerjaData    Json?             @map("tenaga_kerja_data")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  lokasiProyek       String?           @map("lokasi_proyek")
  petaPekerjaan      Json?             @map("peta_pekerjaan")
  tanggalSpmk        String?           @map("tanggal_spmk")
  activities         Activity[]
  materials          Material[]
  auditLogs          ProjectAuditLog[]

  @@map("projects")
}

model ProjectAuditLog {
  id        String   @id @default(cuid())
  changedAt DateTime @default(now()) @map("changed_at")
  fieldName String   @map("field_name")
  newValue  String?  @map("new_value")
  oldValue  String?  @map("old_value")
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_audit_logs")
}

model Activity {
  id                  String               @id @default(cuid())
  projectId           String               @map("project_id")
  name                String               @map("name")
  order               Int                  @default(0) @map("order")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  actionPlanSchedules ActionPlanSchedule[]
  project             Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  schedules           ActivitySchedule[]
  subActivities       SubActivity[]

  @@map("activities")
}

model SubActivity {
  id                  String               @id @default(cuid())
  activityId          String               @map("activity_id")
  name                String               @map("name")
  weight              Float                @map("weight")
  order               Int                  @default(0) @map("order")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  bobotMC0            Float?               @map("bobot_mc0")
  satuan              String?              @map("satuan")
  volumeKontrak       Float?               @map("volume_kontrak")
  volumeMC0           Float?               @map("volume_mc0")
  actionPlanSchedules ActionPlanSchedule[]
  schedules           ActivitySchedule[]
  dailyActivities     DailySubActivity[]
  activity            Activity             @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@map("sub_activities")
}

model ActivitySchedule {
  id               String       @id @default(cuid())
  activityId       String?      @map("activity_id")
  subActivityId    String?      @map("sub_activity_id")
  month            Int          @map("month")
  year             Int          @map("year")
  week             Int          @map("week")
  planPercentage   Float?       @default(0) @map("plan_percentage")
  actualPercentage Float?       @default(0) @map("actual_percentage")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  activity         Activity?    @relation(fields: [activityId], references: [id], onDelete: Cascade)
  subActivity      SubActivity? @relation(fields: [subActivityId], references: [id], onDelete: Cascade)

  @@unique([activityId, month, year, week])
  @@unique([subActivityId, month, year, week])
  @@map("activity_schedules")
}

model ActionPlanSchedule {
  id               String       @id @default(cuid())
  activityId       String?      @map("activity_id")
  subActivityId    String?      @map("sub_activity_id")
  month            Int          @map("month")
  year             Int          @map("year")
  week             Int          @map("week")
  planPercentage   Float?       @default(0) @map("plan_percentage")
  actualPercentage Float?       @default(0) @map("actual_percentage")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  activity         Activity?    @relation(fields: [activityId], references: [id], onDelete: Cascade)
  subActivity      SubActivity? @relation(fields: [subActivityId], references: [id], onDelete: Cascade)

  @@unique([activityId, month, year, week])
  @@unique([subActivityId, month, year, week])
  @@map("action_plan_schedules")
}

model Material {
  id             String             @id @default(cuid())
  projectId      String             @map("project_id")
  jenisMaterial  String             @map("jenis_material")
  volumeSatuan   String             @default("m3") @map("volume_satuan")
  volumeTarget   Float?             @default(0) @map("volume_target")
  tanggalMulai   String?            @map("tanggal_mulai")
  tanggalSelesai String?            @map("tanggal_selesai")
  waktuSelesai   Int?               @map("waktu_selesai")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  schedules      MaterialSchedule[]
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("materials")
}

model MaterialSchedule {
  id                 String   @id @default(cuid())
  materialId         String   @map("material_id")
  date               String   @map("date")
  rencana            Float?   @default(0) @map("rencana")
  rencanaKumulatif   Float?   @default(0) @map("rencana_kumulatif")
  realisasi          Float?   @default(0) @map("realisasi")
  realisasiKumulatif Float?   @default(0) @map("realisasi_kumulatif")
  tercapai           String?  @default("Y") @map("tercapai")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  material           Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([materialId, date])
  @@map("material_schedules")
}

model ActivityProposal {
  id                 String              @id @default(cuid())
  tahun              String              @map("tahun")
  prioritas          String              @map("prioritas")
  kategoriKegiatan   String              @map("kategori_kegiatan")
  jenisDaerahIrigasi String?             @map("jenis_daerah_irigasi")
  daerahIrigasi      String?             @map("daerah_irigasi")
  outcome            Float?              @default(0) @map("outcome")
  kebutuhanAnggaran  Float?              @default(0) @map("kebutuhan_anggaran")
  anggaranPerHektar  Float?              @default(0) @map("anggaran_per_hektar")
  ipExisting         Float?              @default(0) @map("ip_existing")
  ipRencana          Float?              @default(0) @map("ip_rencana")
  status             String              @default("Draft") @map("status")
  readinessLevel     String              @default("0%") @map("readiness_level")
  submittedBy        String?             @map("submitted_by")
  reviewedBy         String?             @map("reviewed_by")
  approvedBy         String?             @map("approved_by")
  reviewNotes        String?             @map("review_notes")
  submittedAt        DateTime?           @map("submitted_at")
  reviewedAt         DateTime?           @map("reviewed_at")
  approvedAt         DateTime?           @map("approved_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  lingkupUsulan      LingkupUsulan[]
  readinessCriteria  ReadinessCriteria[]

  @@map("activity_proposals")
}

model LingkupUsulan {
  id                String           @id @default(cuid())
  proposalId        String           @map("proposal_id")
  namaLingkupUsulan String           @map("nama_lingkup_usulan")
  nomenkaltur       String?          @map("nomenkaltur")
  koordinatGeoJson  Json?            @map("koordinat_geojson")
  perimeter         Float?           @map("perimeter")
  area              Float?           @map("area")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  proposal          ActivityProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@map("lingkup_usulan")
}

model ReadinessCriteria {
  id          String           @id @default(cuid())
  proposalId  String           @map("proposal_id")
  dokumenType String           @map("dokumen_type")
  keterangan  String?          @map("keterangan")
  fileName    String?          @map("file_name")
  filePath    String?          @map("file_path")
  fileSize    Int?             @map("file_size")
  uploadedAt  DateTime?        @map("uploaded_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  proposal    ActivityProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@map("readiness_criteria")
}

model User {
  id              String             @id @default(cuid())
  username        String             @unique @map("username")
  email           String             @unique @map("email")
  name            String             @map("name")
  role            String             @default("user") @map("role")
  phoneNumber     String?            @map("phone_number")
  isActive        Boolean            @default(true) @map("is_active")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  dailyActivities DailySubActivity[]

  @@map("users")
}

model DailySubActivity {
  id                      String      @id @default(cuid())
  subActivityId           String      @map("sub_activity_id")
  koordinat               Json?       @map("koordinat")
  catatanKegiatan         String?     @map("catatan_kegiatan")
  file                    Json?       @map("file")
  progresRealisasiPerHari Float?      @default(0) @map("progres_realisasi_per_hari")
  tanggalProgres          String      @map("tanggal_progres")
  createdAt               DateTime    @default(now()) @map("created_at")
  updatedAt               DateTime    @updatedAt @map("updated_at")
  userId                  String      @map("user_id")
  subActivity             SubActivity @relation(fields: [subActivityId], references: [id], onDelete: Cascade)
  user                    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([subActivityId, tanggalProgres, userId])
  @@map("daily_sub_activities")
}

model Wilayah {
  kode String @id
  nama String

  @@index([nama])
  @@map("wilayah")
}
