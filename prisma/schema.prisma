generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model Balai {
  id          String       @id @default(cuid())
  name        String       @map("name")
  code        String       @unique @map("code")
  description String?      @map("description")
  address     String?      @map("address")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  satkers     Satker[]
  users       User[]

  @@map("balai")
}

model Satker {
  id          String    @id @default(cuid())
  name        String    @map("name")
  code        String    @map("code")
  description String?   @map("description")
  balaiId     String    @map("balai_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  balai       Balai     @relation(fields: [balaiId], references: [id], onDelete: Cascade)
  projects    Project[]
  users       User[]

  @@unique([balaiId, code])
  @@map("satkers")
}

model Project {
  id                 String              @id @default(cuid())
  pekerjaan          String?
  spmk               String?
  akhirKontrak       String?             @map("akhir_kontrak")
  alatData           Json?               @map("alat_data")
  bangunanDeviasi    Float?              @default(0) @map("bangunan_deviasi")
  bangunanProgress   Float?              @default(0) @map("bangunan_progress")
  bangunanTarget     Float?              @default(0) @map("bangunan_target")
  createdAt          DateTime            @default(now()) @map("created_at")
  fisikDeviasi       Float?              @default(0) @map("fisik_deviasi")
  fisikProgress      Float?              @default(0) @map("fisik_progress")
  fisikTarget        Float?              @default(100) @map("fisik_target")
  jenisPaket         String?             @map("jenis_paket")
  jenisPengadaan     String?             @map("jenis_pengadaan")
  keuanganDeviasi    Float?              @default(0) @map("keuangan_deviasi")
  keuanganProgress   Float?              @default(0) @map("keuangan_progress")
  keuanganTarget     Float?              @default(0) @map("keuangan_target")
  masaKontrak        String?             @map("masa_kontrak")
  materialData       Json?               @map("material_data")
  nilaiKontrak       String?             @map("nilai_kontrak")
  nomorKontrak       String?             @map("nomor_kontrak")
  numberOfWeeks      Int?                @map("number_of_weeks")
  outputData         Json?               @map("output_data")
  paguAnggaran       String?             @map("pagu_anggaran")
  pembayaranTerakhir String?             @map("pembayaran_terakhir")
  penyediaJasa       String?             @map("penyedia_jasa")
  saluranDeviasi     Float?              @default(0) @map("saluran_deviasi")
  saluranProgress    Float?              @default(0) @map("saluran_progress")
  saluranTarget      Float?              @default(0) @map("saluran_target")
  tanggalKontrak     String?             @map("tanggal_kontrak")
  tenagaKerjaData    Json?               @map("tenaga_kerja_data")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  lokasiProyek       String?             @map("lokasi_proyek")
  petaPekerjaan      Json?               @map("peta_pekerjaan")
  tanggalSpmk        String?             @map("tanggal_spmk")
  satkerId           String?             @map("satker_id")
  activities         Activity[]
  assignments        ProjectAssignment[]
  addendums          Addendums[]
  auditLogs          ProjectAuditLog[]
  satker             Satker?         @relation(fields: [satkerId], references: [id])

  @@map("projects")
}

model ProjectAuditLog {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  fieldName String   @map("field_name")
  oldValue  String?  @map("old_value")
  newValue  String?  @map("new_value")
  changedAt DateTime @default(now()) @map("changed_at")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_audit_logs")
}

model Addendums {
  id                 String    @id @default(cuid())
  projectId          String    @map("project_id")
  addendumNumber     String    @map("addendum_number")
  title              String    @map("title")
  description        String?   @map("description")
  oldValue           String?   @map("old_value")
  newValue           String?   @map("new_value")
  changeType         String    @map("change_type") // TIME_EXTENSION, VALUE_CHANGE, SCOPE_CHANGE, etc.
  effectiveDate      DateTime? @map("effective_date")
  documentPath       String?   @map("document_path")
  approvedBy         String?   @map("approved_by")
  approvedAt         DateTime? @map("approved_at")
  isActive           Boolean   @default(true) @map("is_active")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  project            Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("addendums")
}

model Activity {
  id                  String               @id @default(cuid())
  projectId           String               @map("project_id")
  name                String               @map("name")
  order               Int                  @default(0) @map("order")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  project             Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subActivities       SubActivity[]

  @@map("activities")
}

model SubActivity {
  id                  String               @id @default(cuid())
  activityId          String               @map("activity_id")
  name                String               @map("name")
  weight              Float                @map("weight")
  order               Int                  @default(0) @map("order")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  satuan              String?              @map("satuan")
  volume              Float?               @map("volume")
  
  schedules           Schedule[]
  dailyReports        DailyReport[]
  analisaKebutuhan  AnalisaKebutuhan[]

  activity            Activity             @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@map("sub_activities")
}

model Schedule {
  id                 String      @id @default(cuid())
  subActivityId      String      @map("sub_activity_id")
  weekNumber         Int         @map("week_number")
  plan               Float?      @default(0) @map("plan")
  actionPlan         Float?      @default(0) @map("action_plan")
  realization        Float?      @default(0) @map("realization")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  subActivity        SubActivity @relation(fields: [subActivityId], references: [id], onDelete: Cascade)

  @@unique([subActivityId, weekNumber])
  @@map("schedules")
}

model User {
  id                 String              @id @default(cuid())
  username           String              @unique @map("username")
  email              String              @unique @map("email")
  name               String              @map("name")
  isActive           Boolean             @default(true) @map("is_active")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  lastLoginAt        DateTime?           @map("last_login_at")
  password           String              @map("password")
  role               UserRole            @default(PPK) @map("role")
  balaiId            String?             @map("balai_id")
  satkerId           String?             @map("satker_id")
  deviceInfo         Json?               @map("device_info")
  lastMobileSync     DateTime?           @map("last_mobile_sync")

  accounts           Account[]
  dailyReport        DailyReport[]
  projectAssignments ProjectAssignment[]
  sessions           Session[]
  balai              Balai?              @relation(fields: [balaiId], references: [id])
  satker             Satker?         @relation(fields: [satkerId], references: [id])

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model ProjectAssignment {
  id         String                @id @default(cuid())
  userId     String                @map("user_id")
  projectId  String                @map("project_id")
  role       ProjectAssignmentRole @map("role")
  assignedAt DateTime              @default(now()) @map("assigned_at")
  assignedBy String?               @map("assigned_by")
  isActive   Boolean               @default(true) @map("is_active")
  notes      String?               @map("notes")
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")
  project    Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId, role])
  @@map("project_assignments")
}

model DailyReport {
  id                      String      @id @default(cuid())
  subActivityId           String      @map("sub_activity_id")
  userId                  String      @map("user_id")
  koordinat               Json?       @map("koordinat")
  catatanKegiatan         String?     @map("catatan_kegiatan")
  file                    Json?       @map("file")
  progresRealisasiPerHari Float?      @default(0) @map("progres_realisasi_per_hari")
  tanggalProgres          String      @map("tanggal_progres")
  createdAt               DateTime    @default(now()) @map("created_at")
  updatedAt               DateTime    @updatedAt @map("updated_at")
  
  subActivity             SubActivity @relation(fields: [subActivityId], references: [id], onDelete: Cascade)
  user                    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([subActivityId, tanggalProgres, userId])
  @@map("daily_sub_activities")
}

model Wilayah {
  kode String @id
  nama String

  @@index([nama])
  @@map("wilayah")
}

model KategoriKebutuhan {
  id        String      @id @default(cuid())
  nama      String      @unique @map("nama")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  kebutuhan Kebutuhan[]

  @@map("kategori_kebutuhan")
}

model Kebutuhan {
  id                   String              @id @default(cuid())
  kategoriKebutuhanId  String              @map("kategori_kebutuhan_id")
  nama                 String              @map("nama")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  kategoriKebutuhan    KategoriKebutuhan   @relation(fields: [kategoriKebutuhanId], references: [id], onDelete: Cascade)
  analisaKebutuhan     AnalisaKebutuhan[]

  @@map("kebutuhan")
}

model AnalisaKebutuhan {
  id                              String                  @id @default(cuid())
  subActivityId                   String                  @map("sub_activity_id")
  kebutuhanId                     String                  @map("kebutuhan_id")
  koefisien                       Float                   @map("koefisien")
  hasil                           Float?                  @default(0) @map("hasil")
  satuanHasil                     String?                 @map("satuan_hasil")
  hasilAnalisaKebutuhan          Float?                  @default(0) @map("hasil_analisa_kebutuhan")
  satuanHasilAnalisaKebutuhan    String?                 @map("satuan_hasil_analisa_kebutuhan")
  stokHarian                      Float?                  @default(0) @map("stok_harian")
  terpasang                       Float?                  @default(0) @map("terpasang")
  totalSisaStokHariIni           Float?                  @default(0) @map("total_sisa_stok_hari_ini")
  createdAt                       DateTime                @default(now()) @map("created_at")
  updatedAt                       DateTime                @updatedAt @map("updated_at")
  subActivity                     SubActivity             @relation(fields: [subActivityId], references: [id], onDelete: Cascade)
  kebutuhan                       Kebutuhan               @relation(fields: [kebutuhanId], references: [id], onDelete: Cascade)
  resourceFlowSchedules          ResourceFlowSchedule[]

  @@unique([subActivityId, kebutuhanId])
  @@map("analisa_kebutuhan")
}

model ResourceFlowSchedule {
  id               String           @id @default(cuid())
  analisaKebutuhanId String         @map("analisa_kebutuhan_id")
  tanggal          String           @map("tanggal")
  rencana          Float?           @default(0) @map("rencana")
  realisasi        Float?           @default(0) @map("realisasi")
  file             Json?            @map("file")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  analisaKebutuhan AnalisaKebutuhan @relation(fields: [analisaKebutuhanId], references: [id], onDelete: Cascade)

  @@unique([analisaKebutuhanId, tanggal])
  @@map("resource_flow_schedules")
}

enum UserRole {
  ADMIN_SISTEM
  ADMIN_BALAI
  DIRJEN_SDA
  KABALAI
  SATKER
  PPK
  VENDOR
}

enum ProjectAssignmentRole {
  PPK
  VENDOR
}
